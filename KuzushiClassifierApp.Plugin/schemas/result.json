{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwadraten.dev/kuzushi-classifier/schemas/result.json",
  "title": "Kuzushi Classifier action result",
  "description": "Immutable result produced by classify/similar/analyze and fetchable as results/{result_id}.json. classify fills only candidates; similar fills only similar_images; analyze fills both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "action", "resource_uri", "candidates", "similar_images"],
  "properties": {
    "result_id": { "type": "string", "minLength": 1 },
    "action": { "enum": ["classify", "similar", "analyze"] },
    "resource_uri": {
      "type": "string",
      "pattern": "^results/[A-Za-z0-9_-]+\\.json$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence"],
        "properties": {
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "similar_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "similarity"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "similarity": { "type": "number", "minimum": -1, "maximum": 1 },
          "image_base64": {
            "type": "string",
            "description": "Base64-encoded bytes of the matched dataset image, resolved from the embedding Parquet's embedded WebP payloads; omitted when the bytes could not be resolved."
          },
          "media_type": {
            "enum": ["image/png", "image/jpeg", "image/webp"],
            "description": "Media type of image_base64; the bundled dataset stores image/webp."
          }
        }
      }
    }
  }
}
