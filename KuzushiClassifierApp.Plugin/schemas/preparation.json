{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwadraten.dev/kuzushi-classifier/schemas/preparation.json",
  "title": "Kuzushi Classifier preparation snapshot",
  "description": "Point-in-time state of the plugin's single background preparation job, as returned by prepare_assets/cancel_preparation and embedded in status.json. models_loaded/index_loaded reflect live ONNX sessions and the built similarity index, never file existence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "message",
    "fraction",
    "models_loaded",
    "index_loaded",
    "error",
    "downloads_performed",
    "bytes_downloaded",
    "total_bytes",
    "items_processed",
    "total_items"
  ],
  "properties": {
    "state": {
      "enum": ["idle", "needs_download", "preparing", "ready", "failed", "cancelled"]
    },
    "message": { "type": "string" },
    "fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "models_loaded": { "type": "boolean" },
    "index_loaded": { "type": "boolean" },
    "error": { "type": ["string", "null"] },
    "downloads_performed": { "type": "boolean", "description": "Always false in the plugin — downloads are performed by the host's managed-files surface, not the plugin." },
    "bytes_downloaded": { "type": ["integer", "null"], "minimum": 0 },
    "total_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "items_processed": { "type": ["integer", "null"], "minimum": 0 },
    "total_items": { "type": ["integer", "null"], "minimum": 0 }
  }
}
