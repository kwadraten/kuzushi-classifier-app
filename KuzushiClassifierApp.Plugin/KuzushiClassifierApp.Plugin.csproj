<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.3.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>KuzushiClassifierApp.Plugin</AssemblyName>
    <RootNamespace>KuzushiClassifierApp.Plugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KuzushiClassifierApp\KuzushiClassifierApp.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin view documents ship inside the assembly: the packaged plugin
         zip must not depend on loose files next to the executable. The
         LogicalName is referenced by PluginViewAssets. -->
    <EmbeddedResource Include="Views\main.html" LogicalName="KuzushiClassifierApp.Plugin.Views.main.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="schemas\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\patchouli-plugin.toml" Link="patchouli-plugin.toml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\.agents\plugin-usage.md" Link=".agents\plugin-usage.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
